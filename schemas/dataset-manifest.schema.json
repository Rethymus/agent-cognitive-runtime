{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "example_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
            "minLength": 1,
            "maxLength": 80
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "maxLength": 64
          },
          "group_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
            "minLength": 1,
            "maxLength": 80
          },
          "split": {
            "type": "string",
            "enum": [
              "train",
              "calibration",
              "holdout"
            ]
          }
        },
        "required": [
          "example_id",
          "content_sha256",
          "group_id",
          "split"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "examples"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content-free dataset fingerprint manifest"
}
