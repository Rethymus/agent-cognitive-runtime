{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acr:v0.1:task-contract",
  "title": "task-contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "user_id",
        "project_id",
        "domain"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "in_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "known": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "execution",
              "schema",
              "source_check",
              "calculation",
              "human_review"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "description",
          "method",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "authorization": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "allowed_side_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "source_ref",
        "allowed_tools",
        "allowed_side_effects",
        "write_scope"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "enum": [
            "USD"
          ]
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_teacher_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "currency",
        "max_cost",
        "max_tool_calls",
        "max_retries",
        "max_teacher_rounds",
        "deadline"
      ],
      "additionalProperties": false
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_family",
        "complexity",
        "risk",
        "verifiability"
      ],
      "properties": {
        "task_family": {
          "type": "string",
          "minLength": 1
        },
        "complexity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "verifiability": {
          "enum": [
            "executable",
            "source_checkable",
            "human_review",
            "unknown"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "scope",
    "goal",
    "deliverables",
    "in_scope",
    "out_of_scope",
    "constraints",
    "known",
    "unknown",
    "success_criteria",
    "authorization",
    "budget",
    "rollback",
    "classification"
  ],
  "additionalProperties": false
}
