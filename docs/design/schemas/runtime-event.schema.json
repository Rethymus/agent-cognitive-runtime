{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acr:v0.1:runtime-event",
  "title": "runtime-event",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "from_state": {
      "enum": [
        "Classify",
        "Retrieve",
        "Contract",
        "Plan",
        "Act",
        "Verify",
        "Deliver",
        "Reflect",
        "Evaluate",
        "Promote",
        "NoLearning",
        "NeedInput",
        "Reconcile",
        "Partial",
        "Blocked"
      ]
    },
    "to_state": {
      "enum": [
        "Classify",
        "Retrieve",
        "Contract",
        "Plan",
        "Act",
        "Verify",
        "Deliver",
        "Reflect",
        "Evaluate",
        "Promote",
        "NoLearning",
        "NeedInput",
        "Reconcile",
        "Partial",
        "Blocked"
      ]
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "budget_remaining": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "from_state",
    "to_state",
    "contract_revision",
    "subject_hash",
    "receipt_refs",
    "timestamp",
    "budget_remaining"
  ],
  "additionalProperties": false
}
