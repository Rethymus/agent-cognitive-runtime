{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acr:v0.1:context-manifest",
  "title": "context-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "token_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "revision",
          "content_hash",
          "source_ref",
          "purpose",
          "token_count"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "token_budget": {
      "type": "integer",
      "minimum": 0
    },
    "deletion_epoch": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "contract_revision",
    "items",
    "total_tokens",
    "token_budget",
    "deletion_epoch"
  ],
  "additionalProperties": false
}
