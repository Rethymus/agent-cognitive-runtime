{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acr:v0.1:eval-receipt",
  "title": "eval-receipt",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1"
      ]
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "grader_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "user_id",
        "project_id",
        "domain"
      ],
      "additionalProperties": false
    },
    "model_config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "split": {
      "enum": [
        "development",
        "promotion",
        "locked_audit",
        "regression",
        "transfer"
      ]
    },
    "contamination_checked": {
      "type": "boolean"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "n_independent_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_successes": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_successes": {
          "type": "integer",
          "minimum": 0
        },
        "paired_delta": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "ci_low": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "ci_high": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "critical_regressions": {
          "type": "integer",
          "minimum": 0
        },
        "cost_per_success_ratio": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "n_independent_tasks",
        "baseline_successes",
        "candidate_successes",
        "paired_delta",
        "ci_low",
        "ci_high",
        "critical_regressions",
        "cost_per_success_ratio"
      ],
      "additionalProperties": false
    },
    "raw_results_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "issued_at",
    "expires_at",
    "issuer",
    "key_id",
    "signature",
    "candidate_hash",
    "baseline_hash",
    "protocol_hash",
    "dataset_hash",
    "grader_hash",
    "scope",
    "model_config_hash",
    "result",
    "split",
    "contamination_checked",
    "metrics",
    "raw_results_ref"
  ],
  "additionalProperties": false
}
