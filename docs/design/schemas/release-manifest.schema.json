{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acr:v0.1:release-manifest",
  "title": "release-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1"
      ]
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_release": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "status": {
      "enum": [
        "canary",
        "stable",
        "revoked"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "user_id",
        "project_id",
        "domain"
      ],
      "additionalProperties": false
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "eval_receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "review_ref": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "deletion_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "publisher_identity": {
      "type": "string",
      "minLength": 1
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "parent_release",
    "status",
    "scope",
    "candidate_hash",
    "policy_hash",
    "resources",
    "eval_receipt_refs",
    "review_ref",
    "dependencies",
    "deletion_epoch",
    "publisher_identity",
    "key_id",
    "signature"
  ],
  "additionalProperties": false
}
